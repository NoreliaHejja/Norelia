# Másold le .env néven, és töltsd ki. A .env SOHA nem kerül gitbe.
# Az új CooSpace (2025 ősz óta): https://unics.szte.hu
COOSPACE_URL=https://unics.szte.hu/
COOSPACE_LOGIN_TYPE=felsooktatas
# Neptun-kód / felhasználónév és jelszó – csak az űrlap előkitöltéséhez.
# A reCAPTCHA-t és a "Belépés" gombot mindig te nyomod meg.
COOSPACE_USER=
COOSPACE_PASS=
ANTHROPIC_API_KEY=

# Melyik tanév színtereit figyelje
TERM=2026/27

# Hibariasztás e-mailben (Gmail esetén alkalmazásjelszó kell)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_TO=
